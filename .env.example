# Local development. Production injection is in DEPLOY_AWS.md.
# Do not set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.
# Locally the AWS SDK uses your ~/.aws profile. On Lambda it uses the execution role.

AWS_REGION=af-south-1

# InfluxDB host and bucket name. The token is SSM /senseagri/dev/influxdb/token.
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_BUCKET=senseagri-telemetry
# INFLUXDB_ORG is not read by the app.

# Clerk. Copy the same instance you use today; do not rotate during the move.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Web Push. Copy the existing VAPID keys or current browsers must re-subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. Defaults are the dev table names.
# PUSH_TABLE=senseagri-dev-push-subscriptions
# ALERTS_TABLE=senseagri-dev-alerts
# ALERTS_REQUIRE_SHARED=true
