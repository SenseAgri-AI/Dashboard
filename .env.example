# ── InfluxDB (telemetry) ───────────────────────────────────
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_ORG=a7a2592ed15637b2
INFLUXDB_BUCKET=senseagri-telemetry

# ── AWS (SSM Parameter Store: Influx token, Google SA, per-farm config) ──
AWS_REGION=af-south-1
# AWS creds needed on Vercel (locally uses ~/.aws profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Clerk (auth: email accounts, 2FA, Organizations = one org per farm) ──
# Create an app at https://dashboard.clerk.com → enable Organizations + MFA.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Per-farm config lives in SSM at /senseagri/farms/<org-slug>/config (JSON) —
# no env var needed. See src/lib/farms.ts for the shape.
